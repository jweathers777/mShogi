.execution.lock
**/.lock
# Raw initial reference JSON remains local and is preserved in the verified tar bundle.
qualification/*/analysis/
qualification/*/analysis-summary.json
balance-screen/
# Completed qualification/raw sources are retained in qualification-complete-evidence.tar.gz.
qualification-extension/
pilot-confirmations/
final-balance-screen/
# Live main computation output is packaged and reviewed per completed batch.
main/batch-*/

# Local frozen executable copies for replay; build output never committed.
migration/local-executables/

# Cloud raw evidence remains immutable in GCS and in this local verified cache.
cloud-primary/local-cache/

# Byte-exact compressed review metadata is tracked; expanded JSON is a local convenience.
cloud-primary/batch-01-review/remote-inventory.json
cloud-primary/batch-01-review/review-index.json
cloud-primary/batch-01-review/dispositions-00-04.json
cloud-primary/batch-01-review/evidence-05-09.json

# Batch02 expanded metadata; byte-exact archives are tracked.
cloud-primary/batch-02-review/remote-inventory.json
cloud-primary/batch-02-review/review-index.json
cloud-primary/batch-02-review/dispositions-00-04.json
cloud-primary/batch-02-review/evidence-05-09.json
