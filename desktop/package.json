{
  "name": "mshogi-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-frontend.mjs",
    "build:verification": "node scripts/build-frontend.mjs --verification",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "tauri": "tauri",
    "engine:prepare": "node scripts/prepare-engine.mjs",
    "desktop:dev": "npm run engine:prepare && tauri dev",
    "desktop:build": "npm run engine:prepare && tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "jsdom": "28.1.0"
  }
}
