{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mShogi",
  "version": "0.1.0",
  "identifier": "org.mshogi.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "mShogi",
        "width": 1180,
        "height": 820,
        "minWidth": 760,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "deb",
      "nsis"
    ],
    "externalBin": [
      "binaries/mshogi"
    ],
    "icon": [
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/32x32.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Game",
    "shortDescription": "Chess with the mShogi native engine",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
